APP_NAME=DevPilot
DATABASE_URL=sqlite:////app/data/agentic_devops.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=100

# Choose s3 for Amazon S3, or local for offline development.
STORAGE_MODE=s3
LOCAL_STORAGE_PATH=/app/storage
AWS_REGION=ap-south-1
S3_BUCKET_NAME=devpilot-shoaib-storage-2026

# Preferred: configure AWS credentials on the host using `aws configure`,
# or set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY in this file.
# Never commit this file or share it. IAM roles are preferred on AWS hosts.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional real EC2 deployment settings (separate from S3 file storage).
EC2_INSTANCE_ID=
DEPLOYMENT_ARTIFACT_BUCKET=

# Optional GitHub read-only token for private repositories.
GITHUB_TOKEN=
